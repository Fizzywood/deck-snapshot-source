{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fizzywood/deck-snapshot-releases/blob/main/stable.schema.json",
  "title": "Deck Snapshot release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "published_at", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[1-9][0-9]*)?$" },
    "published_at": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "size", "sha256"],
        "properties": {
          "name": { "enum": ["deck_snapshot_installer.desktop", "deck-snapshot-linux-amd64.tar.gz", "deck-snapshot-linux-amd64.sha256"] },
          "url": { "type": "string", "pattern": "^https://github\\.com/Fizzywood/deck-snapshot-releases/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[1-9][0-9]*)?/[A-Za-z0-9._-]+$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
